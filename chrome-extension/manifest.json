{
  "manifest_version": 3,
  "name": "Vẽ Tay · Google Flow",
  "version": "1.3.38",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "debugger",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.googleusercontent.com/*",
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://muse.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "flow.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://muse.ai/*"
      ],
      "js": [
        "flow.js"
      ],
      "run_at": "document_start"
    }
  ]
}
